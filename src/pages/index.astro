---
import "@styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Famindex | Redireccionando...</title>

    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content="0; url=/es/" />

    <script is:inline>
      window.location.replace("/es/");
    </script>
  </head>

  <body
    class="bg-[#101828] flex flex-col justify-center items-center min-h-screen font-sans text-[#F8FAFC] text-center px-4"
  >
    <div
      class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 border-8 border-[#1E293B] border-t-[#38BDF8] rounded-full animate-spin mb-8"
    >
    </div>

    <p class="text-2xl sm:text-3xl md:text-4xl font-semibold text-white">
      Redirigiendo...
    </p>
  </body>
</html>
